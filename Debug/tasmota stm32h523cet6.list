// =============================================================================
// FUNGSI PUBLIK
// =============================================================================
void WebCmnd_Handle(uint8_t *rx_buf, uint16_t rx_len)
{
90005200:	b5f0      	push	{r4, r5, r6, r7, lr}
    (void)rx_len;
    char *req = (char *)rx_buf;
    // =========================================================
    // GET /cmnd → kirim halaman HTML
